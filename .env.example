# Optional paths to password files outside the repository.
# No passwords belong in this file or in environment variables.
POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres_admin_password
POSTGRES_APP_PASSWORD_FILE=./secrets/postgres_app_password

# ETL password file: ./secrets/postgres_etl_password (not stored in Git).

# Optional SMTP override: docker-compose.smtp.yml
CONTACT_SMTP_USERNAME=kontakt@example.org
CONTACT_MAIL_TO=kontakt@example.org
CONTACT_SMTP_PORT=465
CONTACT_SMTP_PASSWORD_FILE=./secrets/contact_smtp_password
